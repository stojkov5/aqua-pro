# Copy this file to .env.local and fill in real values.
# In production, set the same variables in Vercel → Settings → Environment Variables.
# Variables starting with VITE_ are bundled into the browser code — never put secrets in them.

# Resend — used by api/order.js (server-side only)
RESEND_API_KEY=
ORDER_EMAIL_TO=aquaproswim@gmail.com
ORDER_EMAIL_FROM=Aqua Pro Shop <shop@aquaproswim.com>

# Supabase — Project Settings → API Keys
# Public values (safe in the browser, protected by Row Level Security)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Secret key (server-side only, bypasses Row Level Security)
SUPABASE_SECRET_KEY=
